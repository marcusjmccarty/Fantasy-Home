/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.sleeper.app; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Fonts never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles are requested with ?v=<release>, so a release always fetches
# fresh copies; repeat visits within a release load them from the browser cache.
/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Usage dataset: refreshed periodically, safe to reuse for an hour.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
